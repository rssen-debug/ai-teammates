{
  "name": "studdy-buddy",
  "version": "0.2.0",
  "private": true,
  "description": "Studdy Buddy - evidence-grounded AI study companion, now a first-class CLI",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && vitest run tests/integration/cli-linux-e2e.test.ts tests/integration/external-connectors.test.ts",
    "lint": "eslint .",
    "build": "node scripts/build-cli.mjs",
    "dev": "tsx packages/cli/src/bin.ts",
    "start": "tsx packages/cli/src/bin.ts",
    "package:cli": "node scripts/build-cli.mjs && npm pack ./dist/cli --pack-destination dist",
    "studdy": "tsx packages/cli/src/bin.ts",
    "doctor": "tsx packages/cli/src/bin.ts doctor",
    "prove": "npm run build && node dist/cli/studdy.mjs prove"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.0.0",
    "agent-desktop": "1.2.0"
  },
  "dependencies": {
    "ws": "^8.22.1",
    "zod": "^3.24.1"
  }
}
