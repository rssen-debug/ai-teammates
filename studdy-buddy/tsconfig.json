{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "allowJs": false,
    "baseUrl": ".",
    "paths": {
      "@studdy/shared": ["packages/shared/src/index.ts"],
      "@studdy/shared/*": ["packages/shared/src/*"],
      "@studdy/database": ["packages/database/src/index.ts"],
      "@studdy/ai-router": ["packages/ai-router/src/index.ts"],
      "@studdy/agent-core": ["packages/agent-core/src/index.ts"],
      "@studdy/learning-engine": ["packages/learning-engine/src/index.ts"],
      "@studdy/quiz-engine": ["packages/quiz-engine/src/index.ts"],
      "@studdy/curriculum": ["packages/curriculum/src/index.ts"],
      "@studdy/packet-tracer": ["packages/packet-tracer/src/index.ts"],
      "@studdy/voice-engine": ["packages/voice-engine/src/index.ts"],
      "@studdy/cli": ["packages/cli/src/index.ts"],
      "@studdy/core": ["packages/core/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "apps/desktop/src/**/*.ts", "apps/desktop/src/**/*.tsx", "tests/**/*.ts"],
  "exclude": ["node_modules", "**/dist/**", "archive"]
}
