{
  "manifest_version": 3,
  "name": "Omega Existing Tabs Bridge",
  "version": "0.1.0",
  "description": "Local owner-paired tab automation, without moving the Windows mouse or switching windows.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1/*",
    "ws://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Omega Existing Tabs"
  }
}
